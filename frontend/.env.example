# ---------------------------------------------------------------
# DPS Agra Exam Portal (frontend) - copy to .env and edit
# Vite bakes these values into the build, so rebuild after changes.
# ---------------------------------------------------------------

# Base URL of the backend hosted on Render (no trailing slash)
VITE_API_BASE_URL=https://your-render-backend-url.onrender.com

# Socket.IO server. Leave empty to reuse VITE_API_BASE_URL.
VITE_SOCKET_URL=
VITE_SOCKET_PATH=/socket.io

# true  = run fully on built-in sample data (no backend needed)
# false = talk to the real backend
# If unset: demo mode is ON only when VITE_API_BASE_URL is empty.
VITE_DEMO_MODE=false

# browser = clean URLs (/teacher/dashboard) - needs the bundled .htaccess
# hash    = /#/teacher/dashboard - works on any static host with zero config
VITE_ROUTER_MODE=browser

# Deploying into a sub-folder? e.g. /exam/  (keep leading and trailing slash)
VITE_BASE_PATH=/

# How often students send webcam/screen thumbnails to the monitor grid (ms)
VITE_SNAPSHOT_INTERVAL_MS=10000

# Optional WebRTC ICE servers as JSON. Add a TURN server for school networks.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
