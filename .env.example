NODE_ENV=development
PORT=5000
FRONTEND_URL=https://your-site.42web.io
DATABASE_URL=postgresql://user:password@localhost:5432/dps_exam
DATABASE_SSL=false
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
STUDENT_SESSION_SECRET=replace-with-a-different-long-random-secret
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=School Administrator
STORE_IP=false
FINGERPRINT_PEPPER=replace-with-another-random-secret
UPLOAD_PROVIDER=s3
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_AUTH_TOKEN=

# Optional school email reset delivery. Set in Render, never commit real values.
SMTP_URL=
MAIL_FROM=
ACCOUNT_APP_URL=https://dpslab.onrender.com
# Runs disposable public HTTPS login/exam/monitor checks after a release.
ACCOUNT_RELEASE_SMOKE=false


# Server-only Brevo relay; store the SMTP key privately on Render.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
BREVO_API_KEY=

# Server-only local exam AI gateway. Keep the key in private Render settings.
# Use the HTTPS tunnel origin, with no /health suffix.
DPS_AI_GATEWAY_URL=
DPS_AI_GATEWAY_KEY=
