{
  "name": "dps-agra-exam-portal-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/config/migrate.js",
    "test": "node --test tests/*.test.js && npm run test:accounts && npm --prefix frontend test && npm run test:platform && npm run test:desktop",
    "check": "node scripts/check.js",
    "smoke": "node scripts/smoke-readonly.js",
    "test:signaling": "node --test integration/*.test.js",
    "test:accounts": "node --import ./integration/pglite-db.mjs --test integration/*.test.js",
    "postinstall": "npm --prefix frontend ci && npm --prefix frontend run build",
    "test:platform": "node --import ./integration/pglite-platform.mjs --test platform-integration/*.test.cjs",
    "test:desktop": "npm --prefix desktop test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "socket.io-client": "^4.8.1"
  }
}
